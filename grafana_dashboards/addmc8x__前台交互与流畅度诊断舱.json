        {
          "dataset": "time_audit",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P7A9DAD60F8AB4C18"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH away AS (\n  -- 借用 AHK 已精确检测并写入 app_usage_logs 的\"离开\"状态(睡眠/息屏/键鼠静止/锁屏，自带音频豁免)，\n  -- 把这些时段从前台资源画像中挖空 —— 系统清醒但人不在时，活跃表仍在流，靠它才能斩断卡死平线。\n  SELECT start_time AS s, start_time + make_interval(secs => duration_seconds) AS e\n  FROM public.app_usage_logs\n  WHERE process_name IN ('System_Sleep','System_DisplayOff','System_Idle','System_LockScreen')\n    AND start_time >= $__timeFrom()::timestamptz - interval '10 minutes' AND start_time <= $__timeTo()::timestamptz\n)\nSELECT\n  $__timeGroupAlias(act.\"timestamp\", $__interval, NULL),\n  AVG(act.proc_cpu_usage) AS \"前台 CPU 占用率 (%)\",\n  AVG(act.proc_gpu_usage) AS \"前台 GPU 占用率 (%)\",\n  -- 🌟 核心修改：直接在底层除以 1024.0，强转为 GB\n  AVG(act.proc_ram_mb) / 1024.0 AS \"前台 内存占用 (GB)\",\n  AVG(act.proc_vram_used_gb) AS \"前台 显存占用 (GB)\"\nFROM public.fact_process_activity act\nJOIN public.fact_process_context ctx\n  ON act.process_key = ctx.process_key\n  AND act.os_pid = ctx.os_pid\n  AND act.\"timestamp\" >= ctx.\"timestamp\"\n  AND (act.\"timestamp\" <= ctx.end_timestamp OR ctx.end_timestamp IS NULL)\nWHERE ctx.is_foreground = 1\n  AND $__timeFilter(act.\"timestamp\")\n  AND NOT EXISTS (SELECT 1 FROM away a WHERE act.\"timestamp\" >= a.s AND act.\"timestamp\" < a.e)\nGROUP BY 1\nORDER BY 1 ASC;",
          "refId": "A",
          "sql": {
