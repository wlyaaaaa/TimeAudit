      "targets": [
        {
          "dataset": "time_audit",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P7A9DAD60F8AB4C18"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH process_map(proc_name, alias_name) AS (\r\n  VALUES\r\n    -- 🎯 基础前台五大内鬼\r\n    ('weixin.exe', '💬 微信电脑版'),\r\n    ('pixpin.exe', '📌 PixPin 截图工具'),\r\n    ('applicationframehost.exe', '🪟 Win系统内置应用(照片/设置)'),\r\n    ('mmc.exe', '⚙️ Win微软管理控制台(磁盘/服务)'),\r\n    ('trafficmonitor.exe', '📊 TrafficMonitor 网速计'),\r\n    \r\n    -- ☕ 核心开发与数据库工具\r\n    ('idea64.exe', '☕ IntelliJ IDEA'),\r\n    ('datagrip64.exe', '🛢️ DataGrip 数据库'),\r\n    ('clion64.exe', '🇨 CLion 编辑器'),\r\n    ('code.exe', '📝 VS Code 编辑器'),\r\n    ('wechatappex.exe', '💬 微信小程序进程'),\r\n    ('wxminiprogram.exe', '💬 微信小程序'),\r\n    ('xmind.exe', '🧠 XMind 思维导图'),\r\n    ('apifox.exe', '🦊 Apifox 接口测试'),\r\n    ('anotherredisdesktopmanager.exe', '🗄️ Redis 管理器'),\r\n\r\n    -- 🌐 浏览器与日常办公\r\n    ('chrome.exe', '🌐 Chrome 浏览器'),\r\n    ('msedge.exe', '🌐 Edge 浏览器'),\r\n    ('qq.exe', '🐧 QQ 电脑版'),\r\n    ('wxwork.exe', '💼 企业微信'),\r\n    ('notepad++.exe', '📝 Notepad++'),\r\n    ('notepad.exe', '📝 Windows 记事本'),\r\n    ('typora.exe', '✍️ Typora 笔记'),\r\n    ('winword.exe', '📝 Microsoft Word'),\r\n\r\n    -- 📱 远控与终端系列\r\n    ('pcbu_desktop.exe', '📱 华为妙享/电脑管家'),\r\n    ('miservice.exe', '📱 小米妙享服务'),\r\n    ('mintty.exe', '💻 Git Bash 终端'),\r\n    ('powershell_ise.exe', '💻 PowerShell ISE'),\r\n    ('windowsterminal.exe', '💻 Windows 终端'),\r\n    ('cmd.exe', '💻 命令提示符'),\r\n\r\n    -- 🐳 基建与 AI\r\n    ('docker desktop.exe', '🐳 Docker 桌面端'),\r\n    ('tailscale.exe', '🧅 Tailscale 组网'),\r\n    ('clash verge.exe', '✈️ Clash 代理'),\r\n    ('flyingbird.exe', '🚀 飞鸟加速器'),\r\n    ('bilibili.exe', '📺 哔哩哔哩'),\r\n    ('discord.exe', '💬 Discord 社区'),\r\n    ('claude.exe', '🤖 Claude 桌面端'),\r\n\r\n    -- 🎮 核心游戏矩阵\r\n    ('blackmythwukong.exe', '🐒 黑神话：悟空'),\r\n    ('cyberpunk2077.exe', '🦾 赛博朋克 2077'),\r\n    ('league of legends.exe', '⚔️ 英雄联盟'),\r\n    ('cities2.exe', '🏗️ 城市：天际线 2'),\r\n    ('slaythespire2.exe', '🃏 杀戮尖塔 2'),\r\n    ('frostpunk2.exe', '❄️ 冰汽时代 2'),\r\n    ('masterduel.exe', '🃏 游戏王：决斗大师')\r\n),\r\naway AS (\r\n  -- 借用 AHK 已精确检测并写入 app_usage_logs 的\"离开\"状态(睡眠/息屏/键鼠静止/锁屏，自带音频豁免)，\r\n  -- 把这些时段的网格点挖空 —— 系统清醒但人不在时，活跃表仍在流，靠它才能斩断卡死长条/平线。\r\n  SELECT start_time AS s, start_time + make_interval(secs => duration_seconds) AS e\r\n  FROM public.app_usage_logs\r\n  WHERE process_name IN ('System_Sleep','System_DisplayOff','System_Idle','System_LockScreen')\r\n    AND start_time >= $__timeFrom()::timestamptz - interval '10 minutes' AND start_time <= $__timeTo()::timestamptz\r\n),\r\ntime_grid AS (\r\n  -- 1. 活体骨架层：用 fact_system_hardware(每 tick 仅一行、睡眠时天然断流)做时间骨架，并按视图跨度\r\n  -- 自适应分桶把网格点上限压到 ~2000，避免 7 天+ 范围扫 500 万行 activity 卡死(实测 10s→0.3s)。\r\n  SELECT min(\"timestamp\") AS grid_time\r\n  FROM public.fact_system_hardware\r\n  WHERE $__timeFilter(\"timestamp\")\r\n  GROUP BY floor(extract(epoch from \"timestamp\") / GREATEST(3, extract(epoch from ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) / 2000.0))\r\n),\r\ngrid_mapped AS (\r\n  -- 2. 🗜️ 交叉碰撞层：将每一刻存活的脉搏与前台上下文的假长寿区间做交叉判定\r\n  SELECT\r\n    g.grid_time,\r\n    ctx.process_key,\r\n    reg.process_name,\r\n    -- 核心防御：同一格系统脉搏下如果发生高频切窗冲突，以最新切入（timestamp最大）的事件为尊\r\n    ROW_NUMBER() OVER(PARTITION BY g.grid_time ORDER BY ctx.\"timestamp\" DESC) as rn\r\n  FROM time_grid g\r\n  JOIN public.fact_process_context ctx \r\n    ON g.grid_time >= ctx.\"timestamp\" \r\n    AND (g.grid_time < ctx.end_timestamp OR ctx.end_timestamp IS NULL)\r\n  JOIN public.dim_process_registry reg ON ctx.process_key = reg.process_key\r\n  WHERE ctx.is_foreground = 1\r\n    AND LOWER(reg.process_name) NOT IN (\r\n      'searchhost.exe', 'startmenuexperiencehost.exe', 'openwith.exe', \r\n      'lockapp.exe', 'inno_updater.exe', 'steamwebhelper.exe', \r\n      'tagtunnel.exe', 'xlliveud.exe', 'gameinputsvc.exe'\r\n    )\r\n    AND NOT EXISTS (SELECT 1 FROM away a WHERE g.grid_time >= a.s AND g.grid_time < a.e)\r\n),\r\nprocess_analytics AS (\r\n  -- 3. 📊 绝对精准权重：按照该进程在活体开机状态下被抓获的【真实存活总点数】进行 Top 15 排行\r\n  -- 彻底蒸发了睡眠挂机期间单条记录因没有闭合而膨胀出的假时长权重\r\n  SELECT \r\n    process_key,\r\n    ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS usage_rank\r\n  FROM grid_mapped\r\n  WHERE rn = 1\r\n  GROUP BY process_key\r\n),\r\nfinal_stream AS (\r\n  -- 4. 🏁 纯净分发层：锁死前台物理活跃总时间最长的前 15 个硬核主力应用\r\n  SELECT \r\n    gm.grid_time AS time,\r\n    COALESCE(pm.alias_name, '⚙️ ' || gm.process_name) AS metric,\r\n    1 AS value\r\n  FROM grid_mapped gm\r\n  JOIN process_analytics pa ON gm.process_key = pa.process_key\r\n  LEFT JOIN process_map pm ON LOWER(gm.process_name) = pm.proc_name\r\n  WHERE gm.rn = 1 \r\n    AND pa.usage_rank <= 15\r\n)\r\nSELECT time, metric, value FROM final_stream\r\nORDER BY time ASC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
