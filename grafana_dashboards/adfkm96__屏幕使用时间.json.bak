      "pluginVersion": "13.0.2",
      "targets": [
        {
          "dataset": "time_audit",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P7A9DAD60F8AB4C18"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH base_logs AS (\r\n    SELECT \r\n        start_time,\r\n        process_name,\r\n        -- 🧼 1. 统一阻击：切掉所有软件的末尾冗余后缀\r\n        REGEXP_REPLACE(\r\n            window_title, \r\n            ' - (Google Chrome|Microsoft Edge|Visual Studio Code|Cursor|Typora|IntelliJ IDEA|DataGrip)$', \r\n            '', \r\n            'i'\r\n        ) AS cleaned_title,\r\n        duration_seconds\r\n    FROM app_usage_logs\r\n    WHERE $__timeFilter(start_time)\r\n      -- 🚫 剔除挂机和锁屏\r\n      AND process_name NOT IN ('System_Sleep', 'System_DisplayOff', 'System_Idle', 'Idle')\r\n      AND window_title IS NOT NULL \r\n      AND window_title != ''\r\n      AND window_title != 'Windows 桌面 / 壁纸层'\r\n),\r\ncontext_mapped AS (\r\n    SELECT\r\n        start_time,\r\n        CASE\r\n            -- 💬 1. 微信隐私护卫\r\n            WHEN LOWER(process_name) = 'weixin.exe' THEN '💬 社交沟通: 微信 (窗口标题已脱敏)'\r\n\r\n            -- 🤖 2. AI 炼丹与调试\r\n            WHEN cleaned_title LIKE '%Google AI Studio%' THEN '🤖 AI 调试: ' || cleaned_title\r\n            WHEN cleaned_title LIKE '%Gemini%' THEN '🤖 AI 对话: ' || cleaned_title\r\n            WHEN cleaned_title LIKE '%ChatGPT%' OR cleaned_title LIKE '%xAI%' THEN '🤖 AI 助理: ' || cleaned_title\r\n            \r\n            -- 🐙 3. 开源社区与本地联调\r\n            WHEN cleaned_title LIKE '%GitHub%' THEN '🐙 开源社区: ' || cleaned_title\r\n            WHEN cleaned_title LIKE '%localhost%' OR cleaned_title LIKE '%127.0.0.1%' THEN '🌐 本地联调: ' || cleaned_title\r\n\r\n            -- ☕ 4. 研发核心工具\r\n            WHEN LOWER(process_name) = 'idea64.exe' THEN '☕ IDEA项目: ' || cleaned_title\r\n            WHEN LOWER(process_name) = 'datagrip64.exe' THEN '🗄️ SQL架构: ' || cleaned_title\r\n            WHEN LOWER(process_name) IN ('code.exe', 'cursor.exe') THEN '💻 代码心流: ' || cleaned_title\r\n\r\n            -- 📝 5. 运维与系统组件\r\n            WHEN LOWER(process_name) = 'typora.exe' THEN '📝 Markdown: ' || cleaned_title\r\n            WHEN LOWER(process_name) = 'windowsterminal.exe' THEN '💻 终端指令: ' || cleaned_title\r\n            WHEN LOWER(process_name) = 'taskmgr.exe' THEN '📊 系统内核: 任务管理器'\r\n            WHEN LOWER(process_name) = 'explorer.exe' AND cleaned_title LIKE '文件管理器:%' THEN '📁 磁盘路径: ' || cleaned_title\r\n\r\n            -- 🛡️ 6. 安全服务\r\n            WHEN LOWER(process_name) IN ('360safe.exe', '360tray.exe', '360logcenter.exe') THEN '🛡️ 系统防护: 360安全卫士'\r\n            \r\n            -- 🏁 7. 长尾离散应用\r\n            ELSE '🚀 [' || process_name || '] ' || cleaned_title\r\n        END AS task_context,\r\n        duration_seconds\r\n    FROM base_logs\r\n)\r\n-- 📊 3. 时区强制对齐：将时间戳先转换至东八区再进行切片，彻底干掉时区差\r\nSELECT \r\n    TO_CHAR(start_time AT TIME ZONE 'Asia/Shanghai', 'HH24:MI:SS') AS \"切换时刻\",\r\n    TRIM(task_context) AS \"动作上下文\",\r\n    duration_seconds AS \"停留时长\"\r\nFROM context_mapped\r\nORDER BY start_time DESC; -- 👈 底层依然按原生时间线绝对倒序",
          "refId": "A",
          "sql": {
