      },
      "pluginVersion": "13.0.2",
      "targets": [
        {
          "dataset": "time_audit",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfoc1vymtgni8a"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH marked_leads AS (\r\n  SELECT\r\n    start_time,\r\n    duration_seconds,\r\n    process_name,\r\n    window_title,\r\n    -- ⚡ 降维进化：只判断进程名是否改变！只要还在同一个应用里切换窗口，心流就绝对不断\r\n    CASE \r\n      WHEN process_name = LAG(process_name) OVER (ORDER BY start_time) THEN 0\r\n      ELSE 1\r\n    END as is_new_session\r\n  FROM app_usage_logs\r\n  WHERE process_name NOT IN ('System_Sleep', 'System_DisplayOff', 'System_Idle')\r\n    AND $__timeFilter(start_time)\r\n),\r\nsession_groups AS (\r\n  SELECT\r\n    start_time,\r\n    duration_seconds,\r\n    process_name,\r\n    window_title,\r\n    -- 动态累加组标签\r\n    SUM(is_new_session) OVER (ORDER BY start_time) as grp\r\n  FROM marked_leads\r\n),\r\npacked_sessions AS (\r\n  SELECT\r\n    MIN(start_time) as flow_start,\r\n    SUM(duration_seconds) as total_seconds,\r\n    process_name,\r\n    -- 🎯 聚合代表性上下文：提取该专注时间块内最具代表性的窗口名称\r\n    MAX(window_title) as sample_title\r\n  FROM session_groups\r\n  GROUP BY grp, process_name\r\n)\r\nSELECT\r\n  -- 1. 进入时刻\r\n  (flow_start AT TIME ZONE 'Asia/Shanghai' AT TIME ZONE 'Asia/Shanghai') as \"进入心流时刻\",\r\n  -- 2. 核心进程美化显示\r\n  CASE \r\n    WHEN process_name = 'chrome.exe' THEN '🌐 浏览器 (Chrome)'\r\n    WHEN process_name = 'Code.exe' THEN '💻 编译器 (VS Code)'\r\n    WHEN process_name = 'idea64.exe' THEN '☕ 编译器 (IntelliJ IDEA)'\r\n    WHEN process_name = 'explorer.exe' THEN '📁 系统组件 (文件管理器)'\r\n    ELSE '🚀 ' || process_name\r\n  END as \"核心应用\",\r\n  -- 3. 主要任务上下文\r\n  sample_title as \"主要任务上下文\",\r\n  -- 4. 听老哥的，转换成分钟级显示\r\n  ROUND(total_seconds / 60.0, 1) as \"持续专注时间(分钟)\"\r\nFROM packed_sessions\r\n-- 🎯 生产阈值：听老哥的，只要连续呆够 5 分钟（300秒）就定义为黄金心流块\r\nWHERE total_seconds >= 300\r\nORDER BY flow_start DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "专注时间",
      "type": "table"
    },
