      "pluginVersion": "13.0.2",
      "targets": [
        {
          "dataset": "time_audit",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfoc1vymtgni8a"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  CASE \r\n    -- 💻 核心核心生产力 (研发、数据与终端)\r\n    WHEN LOWER(process_name) IN ('code.exe', 'cursor.exe') THEN '💻 开发工具: VS Code / Cursor'\r\n    WHEN LOWER(process_name) = 'idea64.exe' THEN '☕ 开发工具: IntelliJ IDEA'\r\n    WHEN LOWER(process_name) = 'datagrip64.exe' THEN '🗄️ 数仓工具: DataGrip'\r\n    WHEN LOWER(process_name) = 'windowsterminal.exe' THEN '💻 终端工具: Windows Terminal'\r\n    WHEN LOWER(process_name) = 'powershell_ise.exe' THEN '💻 终端工具: PowerShell ISE'\r\n    WHEN LOWER(process_name) = 'cmd.exe' THEN '💻 终端工具: Command Prompt'\r\n    WHEN LOWER(process_name) = 'typora.exe' THEN '📝 笔记工具: Typora'\r\n    WHEN LOWER(process_name) = 'notepad.exe' THEN '📝 文本编辑: 记事本'\r\n    WHEN LOWER(process_name) = 'winword.exe' THEN '📄 办公软件: Microsoft Word'\r\n    WHEN LOWER(process_name) = 'git-credential-manager.exe' THEN '💻 开发工具: Git 凭据管理器'\r\n    WHEN LOWER(process_name) = 'java.exe' THEN '💻 运行环境: Java 虚拟机'\r\n    WHEN LOWER(process_name) LIKE 'python%' THEN '💻 开发工具: Python 运行环境/安装器'\r\n\r\n    -- 🌐 网络、社交、AI与云服务\r\n    WHEN LOWER(process_name) IN ('chrome.exe', 'msedge.exe') THEN '🌐 网络浏览器: ' || process_name\r\n    WHEN LOWER(process_name) = 'weixin.exe' THEN '💬 社交软件: 微信'\r\n    WHEN LOWER(process_name) = 'baidunetdiskunite.exe' THEN '☁️ 网络云盘: 百度网盘'\r\n    WHEN LOWER(process_name) = 'thunder.exe' THEN '⚡ 下载工具: 迅雷'\r\n    WHEN LOWER(process_name) = 'chatlab.exe' THEN '🤖 效率工具: ChatLab AI客户端'\r\n\r\n    -- 📊 硬件监测与外设驱动\r\n    WHEN LOWER(process_name) = 'librehardwaremonitor.exe' THEN '📊 硬件监测: LibreHardwareMonitor'\r\n    WHEN LOWER(process_name) = 'presentmonconsole.exe' THEN '📊 硬件监测: PresentMon 帧率探测'\r\n    WHEN LOWER(process_name) = 'trafficmonitor.exe' THEN '📊 硬件监测: TrafficMonitor'\r\n    WHEN LOWER(process_name) = 'aida64.exe' THEN '📊 硬件监测: AIDA64 性能分析'\r\n    WHEN LOWER(process_name) = 'turzx.exe' THEN '📊 硬件监测: TURZX 智能副屏驱动'\r\n    WHEN LOWER(process_name) = 'cinebench.exe' THEN '📊 性能测试: Cinebench 跑分压测'\r\n    WHEN LOWER(process_name) = 'nvidia app.exe' THEN '⚙️ 驱动控制: NVIDIA App'\r\n    WHEN LOWER(process_name) = 'razerappengine.exe' THEN '⚙️ 驱动控制: Razer 雷云外设管理'\r\n    WHEN LOWER(process_name) = 'evnia precision center.exe' THEN '⚙️ 驱动控制: 飞利浦 Evnia 显示中心'\r\n    WHEN LOWER(process_name) = 'alta2dpconfig.exe' THEN '🎵 音频控制: 蓝牙 A2DP 高清配置'\r\n\r\n    -- 🛠️ 系统辅助与效率工具\r\n    WHEN LOWER(process_name) = 'autohotkey64.exe' THEN '🛠️ 自动化脚本: AutoHotkey'\r\n    WHEN LOWER(process_name) = 'pixpin.exe' THEN '✂️ 截图工具: PixPin'\r\n    WHEN LOWER(process_name) = 'powertoys.filelocksmithui.exe' THEN '🛠️ 系统工具: PowerToys 文件锁分析'\r\n    WHEN LOWER(process_name) = 'docker desktop.exe' THEN '🐳 容器工具: Docker Desktop'\r\n    WHEN LOWER(process_name) = 'fancyrd.exe' THEN '🖥️ 远程桌面: FancyRd Client'\r\n    WHEN LOWER(process_name) = '360zip.exe' THEN '📦 压缩解压: 360压缩'\r\n    WHEN LOWER(process_name) = 'wallpaperui.exe' THEN '🖼️ 桌面美化: 动态壁纸组件'\r\n\r\n    -- 🎮 游戏与媒体娱乐\r\n    WHEN LOWER(process_name) = 'slaythespire2.exe' THEN '🎮 电脑游戏: 杀戮尖塔 2'\r\n    WHEN LOWER(process_name) = 'steamwebhelper.exe' THEN '🎮 游戏平台: Steam 核心服务'\r\n    WHEN LOWER(process_name) = 'uu.exe' THEN '🎮 游戏加速: 网易 UU 加速器'\r\n    WHEN LOWER(process_name) = 'cloudmusic.exe' THEN '🎵 媒体娱乐: 网易云音乐'\r\n\r\n    -- 🖥️ Windows 原生底层核心组件\r\n    WHEN process_name = 'explorer.exe' AND window_title LIKE '文件管理器:%' THEN '📁 系统组件: 文件管理器'\r\n    WHEN process_name = 'explorer.exe' AND window_title = 'Windows 桌面 / 壁纸层' THEN '🖥️ 系统组件: 桌面壁纸层'\r\n    WHEN LOWER(process_name) = 'systemsettings.exe' THEN '⚙️ 系统页面: Windows系统设置'\r\n    WHEN LOWER(process_name) = 'taskmgr.exe' THEN '📊 系统页面: 任务管理器'\r\n    WHEN LOWER(process_name) = 'mmc.exe' THEN '⚙️ 系统页面: MMC 微软管理控制台'\r\n    WHEN LOWER(process_name) = 'regedit.exe' THEN '⚙️ 系统页面: 注册表编辑器'\r\n    WHEN LOWER(process_name) = 'lockapp.exe' THEN '🖥️ 系统组件: Windows 锁屏界面'\r\n    WHEN LOWER(process_name) = 'searchhost.exe' THEN '🖥️ 系统组件: Windows 本地搜索栏'\r\n    WHEN LOWER(process_name) = 'applicationframehost.exe' THEN '🖥️ 系统组件: UWP 应用外壳框架'\r\n    WHEN LOWER(process_name) = 'startmenuexperiencehost.exe' THEN '🖥️ 系统组件: Windows 开始菜单'\r\n    WHEN LOWER(process_name) IN ('shellexperiencehost.exe', 'shellhost.exe') THEN '🖥️ 系统组件: Windows 外壳体验宿主'\r\n    WHEN LOWER(process_name) = 'phoneexperiencehost.exe' THEN '🖥️ 系统组件: 手机连接 (Phone Link)'\r\n    WHEN LOWER(process_name) = 'credentialuibroker.exe' THEN '🖥️ 系统组件: 凭据认证弹窗'\r\n    WHEN LOWER(process_name) = 'openwith.exe' THEN '🖥️ 系统组件: 打开方式选择器'\r\n    WHEN LOWER(process_name) = 'fvenotify.exe' THEN '🖥️ 系统组件: BitLocker 加密通知'\r\n    WHEN LOWER(process_name) = 'pcaui.exe' THEN '🖥️ 系统组件: 程序兼容性助手'\r\n    WHEN LOWER(process_name) = 'wscript.exe' THEN '🖥️ 系统组件: Windows 脚本宿主'\r\n\r\n    -- 🛡️ 安全防御与 360 附属升级/通知组件\r\n    WHEN LOWER(process_name) IN ('360safe.exe', '360tray.exe', '360logcenter.exe', '360leakfix.exe', '360speedld.exe', '360desktoplite64.exe', '360settingcenter.exe', '360dnsopt.exe', '360zipupdate.exe', 'softupnotify.exe', 'pcbu_desktop.exe', 'datamain.exe') THEN '🛡️ 安全防护: 360安全隐私服务群'\r\n    \r\n    -- 🏁 兜底未清洗的离散应用\r\n    ELSE '🚀 应用: ' || process_name \r\n  END as \"活动归属\",\r\n  SUM(duration_seconds) as \"累计时长\"\r\nFROM app_usage_logs\r\nWHERE $__timeFilter(start_time)\r\n  AND process_name NOT IN ('System_Sleep', 'System_DisplayOff', 'System_Idle', 'Idle')\r\nGROUP BY 1\r\nORDER BY 2 DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "前台独占工时高精分布 (今天/实时)",
      "type": "table"
    },
    {
