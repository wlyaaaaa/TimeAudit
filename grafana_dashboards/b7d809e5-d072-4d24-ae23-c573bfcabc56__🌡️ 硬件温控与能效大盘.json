          "format": "time_series",
          "rawSql": "WITH time_bounds AS (\n  SELECT \n    COALESCE(GREATEST($__timeFrom()::timestamptz, MIN(timestamp)), $__timeFrom()::timestamptz) AS range_start,\n    COALESCE(LEAST($__timeTo()::timestamptz, MAX(timestamp)), $__timeTo()::timestamptz) AS range_end\n  FROM public.fact_system_hardware\n  WHERE timestamp >= $__timeFrom()::timestamptz\n    AND timestamp <= $__timeTo()::timestamptz\n),\ntime_grid AS (\n  SELECT generate_series(\n    b.range_start,\n    b.range_end,\n    GREATEST(interval '3 seconds', ('$__interval')::interval)\n  ) AS grid_time\n  FROM time_bounds b\n)\nSELECT \n  g.grid_time AS \"time\",\n  AVG(hw.cpu_package_temp) AS \"CPU 封装温度\",\n  AVG(hw.cpu_package_power) AS \"CPU 封装功率\"\nFROM time_grid g\nLEFT JOIN public.fact_system_hardware hw ON hw.timestamp >= g.grid_time \n  AND hw.timestamp < g.grid_time + GREATEST(interval '3 seconds', ('$__interval')::interval)\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
