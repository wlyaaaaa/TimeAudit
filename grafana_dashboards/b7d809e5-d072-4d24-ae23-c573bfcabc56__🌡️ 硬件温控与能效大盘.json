      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P7A9DAD60F8AB4C18"
          },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(\"timestamp\", $__interval),\n  CASE\n    WHEN bool_or((gpu_throttling_reasons & 96) > 0) THEN '🔥 温度墙'\n    WHEN bool_or((gpu_throttling_reasons & 132) > 0) THEN '⚡ 功耗墙'\n    WHEN bool_or((gpu_throttling_reasons & 8) > 0) THEN '🛑 硬件降速'\n    WHEN bool_or(gpu_throttling_reasons = 1) THEN '💤 空闲降频'\n    ELSE '✅ 满血运行'\n  END AS \"GPU 降频状态\"\nFROM public.fact_system_hardware WHERE $__timeFilter(\"timestamp\") GROUP BY 1 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "GPU 降频原因解码时间线 (撞了哪堵墙)",
