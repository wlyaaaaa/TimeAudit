      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "前台高频应用 Top 10",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "bfoc1vymtgni8a"
                      },
                      "spec": {
                        "dataset": "time_audit",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH total_active_time AS (\r\n    -- 第一步：算出当前筛选时间内，除了静止挂机外的总活跃秒数（防止除以0，给个保底值1）\r\n    SELECT COALESCE(SUM(duration_seconds), 1) as total_active_seconds\r\n    FROM app_usage_logs\r\n    WHERE $__timeFilter(start_time) AND process_name != 'System_Idle'\r\n),\r\naggregated_apps AS (\r\n    -- 第二步：精准清洗应用名，将系统页面、挂机、以及应用彻底中文化分类\r\n    SELECT \r\n        CASE \r\n            WHEN process_name = 'explorer.exe' AND window_title LIKE '文件管理器:%' THEN '📁 系统组件: 文件管理器'\r\n            WHEN process_name = 'explorer.exe' AND window_title = 'Windows 桌面 / 壁纸层' THEN '🖥️ 系统组件: 桌面壁纸层'\r\n            WHEN process_name = 'SystemSettings.exe' THEN '⚙️ 系统页面: Windows系统设置'\r\n            WHEN process_name = 'Taskmgr.exe' THEN '📊 系统页面: 任务管理器'\r\n            WHEN process_name = 'System_Idle' OR process_name = 'Idle' THEN '💤 物理暂离: 键鼠静止挂机'\r\n            ELSE '🚀 应用: ' || process_name \r\n        END as raw_app_name,\r\n        SUM(duration_seconds) as app_seconds\r\n    FROM app_usage_logs\r\n    WHERE $__timeFilter(start_time)\r\n    GROUP BY 1\r\n)\r\n-- 第三步：将百分比和应用名在一行里拼接（例如：\"🚀 应用: chrome.exe (占比 45.2%)\"）\r\n-- 这样图表只需要安心渲染一个统一的“使用时长（时分秒）”就行了，横轴长短绝对一目了然！\r\nSELECT \r\n    raw_app_name || ' (占 ' || ROUND((app_seconds::float / (SELECT total_active_seconds FROM total_active_time) * 100)::numeric, 1) || '%)' as \"应用与占比权重\",\r\n    app_seconds as \"使用时长\"\r\nFROM aggregated_apps\r\nWHERE raw_app_name NOT LIKE '%物理暂离%' -- 既然是前台应用排行，这里剔除纯挂机，只排真实应用的工时\r\nORDER BY app_seconds DESC\r\nLIMIT 10;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
