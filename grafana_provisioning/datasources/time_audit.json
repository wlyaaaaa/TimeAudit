      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "历史每日审计留痕 (活跃/暂离双轴堆叠)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "bfoc1vymtgni8a"
                      },
                      "spec": {
                        "dataset": "time_audit",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  -- ⚡ 核心解法：直接强转为中文年月日字符串，彻底封印 Grafana 的自动时区转换与轴缩放逻辑！\r\n  TO_CHAR(date_trunc('day', start_time AT TIME ZONE 'Asia/Shanghai'), 'YYYY年MM月DD日') as \"审计日期\",\r\n  -- 📊 真实活跃时间：排除暂离、物理睡眠和黑屏\r\n  SUM(CASE WHEN process_name NOT IN ('System_Idle', 'System_Sleep', 'System_DisplayOff') THEN duration_seconds ELSE 0 END) as \"真实键鼠活跃时间\",\r\n  -- 💤 挂机静止时间\r\n  SUM(CASE WHEN process_name = 'System_Idle' THEN duration_seconds ELSE 0 END) as \"挂机静止暂离时间\"\r\nFROM app_usage_logs\r\nWHERE $__timeFilter(start_time)\r\nGROUP BY date_trunc('day', start_time AT TIME ZONE 'Asia/Shanghai')\r\nORDER BY date_trunc('day', start_time AT TIME ZONE 'Asia/Shanghai') ASC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
