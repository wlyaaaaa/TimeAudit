                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  -- 1. 🎯 统计息屏挂机总长：风扇在转、屏幕黑着、人不在\r\n  SUM(CASE WHEN process_name = 'System_DisplayOff' THEN duration_seconds ELSE 0 END) as \"显示器熄灭时长\",\r\n  \r\n  -- 2. 🎯 统计真硬件睡眠总长：主板合盖、风扇彻底停转的冷冻时间\r\n  SUM(CASE WHEN process_name = 'System_Sleep' THEN duration_seconds ELSE 0 END) as \"操作系统深睡眠时长\"\r\nFROM app_usage_logs\r\n-- 🔒 完美套用 Grafana 全局时间筛选器，支持任意历史跨度查询\r\nWHERE $__timeFilter(start_time);",
