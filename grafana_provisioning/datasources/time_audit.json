      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "前台独占工时高精分布 (今天/实时)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
