                      },
                      "spec": {
                        "dataset": "time_audit",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  CASE \r\n    WHEN process_name = 'explorer.exe' AND window_title LIKE '文件管理器:%' THEN '📁 系统组件: 文件管理器'\r\n    WHEN process_name = 'explorer.exe' AND window_title = 'Windows 桌面 / 壁纸层' THEN '🖥️ 系统组件: 桌面壁纸层'\r\n    WHEN process_name = 'SystemSettings.exe' THEN '⚙️ 系统页面: Windows系统设置'\r\n    WHEN process_name = 'Taskmgr.exe' THEN '📊 系统页面: 任务管理器'\r\n    WHEN process_name = 'System_Idle' THEN '💤 物理暂离: 键鼠静止挂机'\r\n    ELSE '🚀 应用: ' || process_name\r\n  END as \"活动归属\",\r\n  SUM(duration_seconds) as \"持续总秒数\"\r\nFROM app_usage_logs\r\nWHERE $__timeFilter(start_time)\r\nGROUP BY \"活动归属\"\r\nORDER BY \"持续总秒数\" DESC",
                        "sql": {
