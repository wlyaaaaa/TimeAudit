      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "前台上下文“频繁闪切”干扰指数",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "bfoc1vymtgni8a"
                      },
                      "spec": {
                        "dataset": "time_audit",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH time_grid AS (\r\n  -- 1. 🛡️ 骨架核心：显式转化 Grafana 宏为 timestamptz，彻底干掉函数重载歧义\r\n  SELECT generate_series(\r\n    date_trunc('minute', $__timeFrom()::timestamptz),\r\n    date_trunc('minute', $__timeTo()::timestamptz),\r\n    '1 minute'::interval\r\n  ) AS grid_time\r\n),\r\nflagged_switches AS (\r\n  -- 2. 🗜️ 核心过滤：计算每一次真实的前台切换\r\n  SELECT\r\n    date_trunc('minute', start_time) as min_time,\r\n    CASE \r\n      WHEN process_name = LAG(process_name) OVER (ORDER BY start_time) \r\n           AND window_title = LAG(window_title) OVER (ORDER BY start_time) THEN 0\r\n      ELSE 1\r\n    END as is_switch\r\n  FROM app_usage_logs\r\n  WHERE process_name NOT IN ('System_Sleep', 'System_DisplayOff', 'System_Idle')\r\n    AND $__timeFilter(start_time)\r\n),\r\nminute_counts AS (\r\n  -- 3. 📊 分钟级初级聚合\r\n  SELECT \r\n    min_time,\r\n    SUM(is_switch) as switch_count\r\n  FROM flagged_switches\r\n  GROUP BY min_time\r\n)\r\n-- 4. 🔗 终审合流：用骨架强行左联。没数据的分钟一律 COALESCE 强制拍成 0 次\r\nSELECT\r\n  (g.grid_time AT TIME ZONE 'Asia/Shanghai' AT TIME ZONE 'Asia/Shanghai') as time,\r\n  COALESCE(mc.switch_count, 0) as \"每分钟前台闪切次数\"\r\nFROM time_grid g\r\nLEFT JOIN minute_counts mc ON g.grid_time = mc.min_time\r\nORDER BY time ASC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
