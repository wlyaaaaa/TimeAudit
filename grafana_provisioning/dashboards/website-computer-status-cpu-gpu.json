      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P7A9DAD60F8AB4C18"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawSql": "WITH bounds AS (\n  SELECT GREATEST($__timeFrom()::timestamptz, now() - interval '24 hours') AS start_time,\n         LEAST($__timeTo()::timestamptz, now()) AS end_time\n), time_grid AS (\n  SELECT generate_series(date_trunc('minute', start_time), date_trunc('minute', end_time), interval '1 minute') AS time\n  FROM bounds\n), points AS (\n  SELECT date_trunc('minute', timestamp) AS time, AVG(cpu_total_usage) AS value\n  FROM public.fact_system_hardware, bounds\n  WHERE timestamp >= bounds.start_time AND timestamp <= bounds.end_time\n  GROUP BY 1\n)\nSELECT g.time AS \"time\", p.value AS \"CPU 占用\"\nFROM time_grid g LEFT JOIN points p ON p.time = g.time\nORDER BY 1;"
        }
      ],
      "maxDataPoints": 1441,
      "interval": "1m"
    },
