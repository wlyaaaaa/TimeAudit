{
  "v": 1,
  "id": "timeaudit",
  "name": "电脑心电图",
  "about": "一直记下电脑的运行、使用和剪贴板，事后能翻回去查。",
  "headline": "missed",
  "tasks": ["task-fc49882cddbce4cd51a3b7ec","task-d1246f7ca07929725308b5c4","task-c072acdc9f077330129a090e","task-8139a378c116c0329c2941bf","task-89ff352234d9364cc424fcff","task-4e1a6d929116598cfb2e5d21"],
  "skills": ["timeaudit-diagnostics"],
  "bindings_complete": true,
  "metrics": [
    {"id": "hardware","label": "电脑状态采样","source": "timeaudit.static","pointer": "/metrics/hardware","time": "/times/hardware","scope": "/scopes/hardware","mode": "static","unit": "条","public": "same","note": "攒了多少；留存量，不是从安装起所有曾采到的总量。","stale_after": 172800},
    {"id": "lifecycle","label": "程序启动和退出","source": "timeaudit.static","pointer": "/metrics/lifecycle","time": "/times/lifecycle","scope": "/scopes/lifecycle","mode": "static","unit": "次","public": "same","note": "攒了多少、好奇；启动和退出各算一次。","stale_after": 172800},
    {"id": "context","label": "前台窗口记录","source": "timeaudit.live","pointer": "/metrics/context","time": "/times/context","scope": "/scopes/context","mode": "live","unit": "段","public": "same","note": "用过哪些窗口，底子有多厚；只给总数，不含窗口标题。","stale_after": 300},
    {"id": "activity","label": "活动记录（在用、空闲、锁屏、睡眠）","source": "timeaudit.live","pointer": "/metrics/activity","time": "/times/activity","scope": "/scopes/activity","mode": "live","unit": "段","public": "same","note": "底子有多厚；也含明确的采集缺口，区间不可直接相加成时长。","stale_after": 300},
    {"id": "earliest","label": "最早能翻回","source": "timeaudit.static","pointer": "/metrics/earliest","time": "/times/earliest","scope": "/scopes/earliest","mode": "static","unit": "","public": "same","note": "能回看多早；仅到日期，首尾不代表中间每天都全。","stale_after": 172800},
    {"id": "raw_since","label": "每个程序的细节能翻回","source": "timeaudit.live","pointer": "/metrics/raw_since","time": "/times/raw_since","scope": "/scopes/raw_since","mode": "live","unit": "","public": "same","note": "旧的还剩什么；此日起是原始明细，更早仍保留小时／日统计。","stale_after": 86400},
    {"id": "db_bytes","label": "记录库总共","source": "timeaudit.live","pointer": "/metrics/db_bytes","time": "/times/db_bytes","scope": "/scopes/db_bytes","mode": "live","unit": "B","public": "same","note": "占了多少盘；含索引，不含独立剪贴板库和库外日志。","stale_after": 3600},
    {"id": "detail_bytes","label": "其中每个程序的细节","source": "timeaudit.live","pointer": "/metrics/detail_bytes","time": "/times/detail_bytes","scope": "/scopes/detail_bytes","mode": "live","unit": "B","public": "same","note": "大头在哪；含分区与索引，不是有效载荷字节。","stale_after": 86400},
    {"id": "summary_bytes","label": "按小时、按天的长期统计","source": "timeaudit.live","pointer": "/metrics/summary_bytes","time": "/times/summary_bytes","scope": "/scopes/summary_bytes","mode": "live","unit": "B","public": "same","note": "旧细节退掉后留下多少；四张现有汇总关系总占用。","stale_after": 86400},
    {"id": "missed","label": "近 24 小时没记上","source": "timeaudit.live","pointer": "/metrics/missed","time": "/times/missed","scope": "/scopes/missed","mode": "live","unit": "","public": "same","note": "今天靠不靠得住、这周修得有没有用；明确缺口并集＋完全没记录的秒数；窗口终点见数据范围。","stale_after": 3600},
    {"id": "latest","label": "最新一条记到","source": "timeaudit.live","pointer": "/metrics/latest","time": "/times/latest","scope": "/scopes/latest","mode": "live","unit": "","public": "same","note": "现在还在记吗；最新已保存活动区间的起点，不能据此断定人在场。","stale_after": 300},
    {"id": "memory","label": "采集程序最高占内存","source": "timeaudit.live","pointer": "/metrics/memory","time": "/times/memory","scope": "/scopes/memory","mode": "live","unit": "MB","public": "same","note": "后台会不会拖累电脑；近24小时主采集进程工作集峰值，含共享页，不是整套采集栈。","stale_after": 3600},
    {"id": "clipboard","label": "能翻回的剪贴板记录","source": "timeaudit.live","pointer": "/metrics/clipboard","time": "/times/clipboard","scope": "/scopes/clipboard","mode": "live","unit": "","public": "same","note": "复制过的东西能找回多少；只查事件类型、时刻和引用是否存在，不读正文、链接、文件路径。","stale_after": 300},
    {"id": "dashboards","label": "看板和图表","source": "timeaudit.live","pointer": "/metrics/dashboards","time": "/times/dashboards","scope": "/scopes/dashboards","mode": "live","unit": "","public": "same","note": "除了流水还做出什么；主看板按 uid 去重，旧版递归排除分组行，V2 只计 Panel／LibraryPanel。","stale_after": 300,"records": "/dashboard_records","shape": "list"},
    {"id": "days","label": "最近 7 天的记录","source": "timeaudit.live","pointer": "/metrics/days","time": "/times/days","scope": "/scopes/days","mode": "live","unit": "","public": "same","note": "每天留下多少、没记上多久；今天截至取数时刻，跨日区间裁剪后求并集。","stale_after": 300,"shape": "table"},
    {"id": "dashboard_open","label": "打开本机看板","source": "timeaudit.owner","pointer": "/metrics/dashboard_open","time": "/times/dashboard_open","scope": "/scopes/dashboard_open","mode": "live","unit": "","public": "owner","note": "本人在这台电脑点开现有 Grafana 看板；不会启用外部共享。","stale_after": 300,"shape": "list"},
    {"id": "viewer","label": "打开本机剪贴板查看器","source": "timeaudit.owner","pointer": "/metrics/viewer","time": "/times/viewer","scope": "/scopes/viewer","mode": "live","unit": "","public": "owner","note": "仅本人、本机；共享网页的本机启动入口尚未接上，未提供打不开的链接。","stale_after": 300},
    {"id": "registry","label": "登记过的进程实例记录","source": "timeaudit.static","pointer": "/metrics/registry","time": "/times/registry","scope": "/scopes/registry","mode": "static","unit": "条","public": "same","note": "好奇；同一应用多次启动会登记多条实例，不是软件数量。","stale_after": 172800},
    {"id": "samples24","label": "近 24 小时留下的整机采样","source": "timeaudit.live","pointer": "/metrics/samples24","time": "/times/samples24","scope": "/scopes/samples24","mode": "live","unit": "条","public": "same","note": "好奇；实际行数，不是每秒一次乘24小时。","stale_after": 3600},
    {"id": "covered24","label": "近 24 小时确实有整机采样的秒数","source": "timeaudit.live","pointer": "/metrics/covered24","time": "/times/covered24","scope": "/scopes/covered24","mode": "live","unit": "秒","public": "same","note": "好奇；按出现样本的秒去重，窗口为86400秒。","stale_after": 3600},
    {"id": "empty24","label": "近 24 小时没有整机采样的秒数","source": "timeaudit.live","pointer": "/metrics/empty24","time": "/times/empty24","scope": "/scopes/empty24","mode": "live","unit": "秒","public": "same","note": "好奇；可能包含停机、睡眠或缺口，不是卡顿或采集故障时长。","stale_after": 3600},
    {"id": "max_gap","label": "近 24 小时最长的整机采样空段","source": "timeaudit.live","pointer": "/metrics/max_gap","time": "/times/max_gap","scope": "/scopes/max_gap","mode": "live","unit": "秒","public": "same","note": "好奇；包含窗口边缘及内部，不代表电脑连续卡住。","stale_after": 3600},
    {"id": "clipboard_latest","label": "剪贴板事件新到什么时候","source": "timeaudit.owner","pointer": "/metrics/clipboard_latest","time": "/times/clipboard_latest","scope": "/scopes/clipboard_latest","mode": "live","unit": "","public": "owner","note": "好奇；无新复制时旧时刻仍是真值，不能单独判断采集停止。","stale_after": 300},
    {"id": "clipboard_events","label": "剪贴板全部事件","source": "timeaudit.live","pointer": "/metrics/clipboard_events","time": "/times/clipboard_events","scope": "/scopes/clipboard_events","mode": "live","unit": "","public": "same","note": "好奇；含观察、跳过、缺口和边界，不当成可回看的正文数量。","stale_after": 300},
    {"id": "clipboard_bytes","label": "独立剪贴板库占用","source": "timeaudit.live","pointer": "/metrics/clipboard_bytes","time": "/times/clipboard_bytes","scope": "/scopes/clipboard_bytes","mode": "live","unit": "B","public": "same","note": "好奇；本机库、WAL、SHM 的当前文件大小，与主记录库分开。","stale_after": 300},
    {"id": "clipboard_temporary","label": "剪贴板目录的旧状态临时文件","source": "timeaudit.live","pointer": "/metrics/clipboard_temporary","time": "/times/clipboard_temporary","scope": "/scopes/clipboard_temporary","mode": "live","unit": "","public": "same","note": "好奇；只数文件个数和大小，不读内容。","stale_after": 300},
    {"id": "website_dashboards","label": "网站看板定义","source": "timeaudit.live","pointer": "/metrics/website_dashboards","time": "/times/website_dashboards","scope": "/scopes/website_dashboards","mode": "live","unit": "份","public": "same","note": "好奇；包括整页与两份拆分，其中图表有重复，未加入主看板总数。","stale_after": 300}
  ],
  "sections": [
    {"id": "retained","label": "攒了多少、能翻回多早","metrics": ["hardware","lifecycle","context","activity","earliest","raw_since"],"about": "攒了多少记录、能回看多早？","note": "几类单位不同，不能相加；首尾日期不代表中间每天都全。"},
    {"id": "storage","label": "占多大地方","metrics": ["db_bytes","detail_bytes","summary_bytes"],"about": "记录占多少盘，大头在哪？","note": "底层给字节；页面按 Windows 口径显示，1 GB＝2³⁰ 字节，1 MB＝2²⁰ 字节。"},
    {"id": "quality","label": "记得全不全、自己吃多少","metrics": ["missed","latest","memory"],"about": "今天靠不靠得住、后台会不会拖累电脑？","note": "缺口与完全没记录分开；采样空段可能包含睡眠和关机。"},
    {"id": "results","label": "留下的成品","metrics": ["clipboard","dashboards","days","dashboard_open","viewer"],"about": "除了流水数据还留下什么可用成品？","note": "剪贴板只给数量和起始日，页面不出任何内容；看板定义不代替线上部署验收。"},
    {"id": "more-data","label": "更多数据","metrics": ["registry","samples24","covered24","empty24","max_gap","clipboard_latest","clipboard_events","clipboard_bytes","clipboard_temporary","website_dashboards"],"about": "好奇：还有多少、留得怎样？","note": "这里的采样空段不是卡顿；内部事件不等于可回看正文。"}
  ],
  "artifacts": {"source": "timeaudit.live","pointer": "/artifacts"},
  "size": {"source": "timeaudit.static","pointer": "/size"},
